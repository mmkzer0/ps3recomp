{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "PS3RECOMP_BUILD_TESTS": "ON" }
    },
    {
      "name": "dev",
      "displayName": "Debug, with tests",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release, with tests",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "PS3RECOMP_SANITIZE": "ON" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "PS3RECOMP_SANITIZE_THREAD": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "displayName": "Every test", "inherits": "base", "configurePreset": "dev" },
    {
      "name": "t0",
      "displayName": "Fast deterministic tier",
      "inherits": "base",
      "configurePreset": "dev",
      "filter": { "include": { "label": "^t0$" } }
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "filter": { "include": { "label": "^t0$" } }
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "filter": { "include": { "label": "^t0$" } },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "filter": { "include": { "label": "^tsan$" } },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/tests/tsan.supp"
      }
    }
  ]
}
