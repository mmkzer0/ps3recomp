{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "PS3RECOMP_BUILD_TESTS": "ON" }
    },
    {
      "name": "dev",
      "displayName": "Debug, with tests",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release, with tests",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "PS3RECOMP_SANITIZE": "ON" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "PS3RECOMP_SANITIZE_THREAD": "ON" }
    },
    {
      "name": "fiber-aarch64",
      "inherits": "dev",
      "cacheVariables": { "PS3RECOMP_FIBER_BACKEND": "aarch64" }
    },
    {
      "name": "fiber-aarch64-asan",
      "inherits": "asan",
      "cacheVariables": { "PS3RECOMP_FIBER_BACKEND": "aarch64" }
    },
    {
      "name": "fiber-aarch64-tsan",
      "inherits": "tsan",
      "cacheVariables": { "PS3RECOMP_FIBER_BACKEND": "aarch64" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    {
      "name": "fiber-aarch64", "configurePreset": "fiber-aarch64",
      "targets": ["fiber_switch", "fiber_worker", "jq2_fiber", "sync2_semaphore", "test_host_fiber_aarch64"]
    },
    {
      "name": "fiber-aarch64-asan", "configurePreset": "fiber-aarch64-asan",
      "targets": ["fiber_switch", "fiber_worker", "jq2_fiber", "sync2_semaphore", "test_host_fiber_aarch64"]
    },
    {
      "name": "fiber-aarch64-tsan", "configurePreset": "fiber-aarch64-tsan",
      "targets": ["fiber_switch", "fiber_worker", "jq2_fiber", "sync2_semaphore", "test_host_fiber_aarch64"]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "displayName": "Every test", "inherits": "base", "configurePreset": "dev" },
    {
      "name": "t0",
      "displayName": "Fast deterministic tier",
      "inherits": "base",
      "configurePreset": "dev",
      "filter": { "include": { "label": "^t0$" } }
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "filter": { "include": { "label": "^t0$" } }
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "filter": { "include": { "label": "^t0$" } },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "filter": { "include": { "label": "^tsan$" } },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/tests/tsan.supp"
      }
    },
    {
      "name": "fiber-aarch64",
      "inherits": "base", "configurePreset": "fiber-aarch64",
      "filter": { "include": { "label": "^(fiber|sync2)$" } }
    },
    {
      "name": "fiber-aarch64-asan",
      "inherits": "asan", "configurePreset": "fiber-aarch64-asan",
      "filter": { "include": { "label": "^(fiber|sync2)$" } },
      "environment": { "ASAN_OPTIONS": "detect_leaks=0:strict_string_checks=1:detect_stack_use_after_return=1" }
    },
    {
      "name": "fiber-aarch64-tsan",
      "inherits": "tsan", "configurePreset": "fiber-aarch64-tsan",
      "filter": { "include": { "label": "^(fiber|sync2)$" } }
    }
  ]
}
