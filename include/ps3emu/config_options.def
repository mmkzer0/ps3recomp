/*
 * ps3recomp - the typed option registry: ONE list, many consumers.
 *
 * Every behavioural option of the runtime is declared here, once. include/
 * ps3emu/config.h expands it into the typed storage and the C accessors,
 * runtime/config/config.cpp into the metadata, the file/environment parsers and
 * the effective-config dump. Nothing else may read a behavioural option by name:
 * call sites use the generated accessor, so a typo is a compile error rather
 * than a silently ignored string.
 *
 *   PS3_CFG_BOOL(section, key, default, doc)
 *   PS3_CFG_U32(section, key, default, min, max, doc)
 *   PS3_CFG_STR(section, key, default, max_length, validator, doc)
 *   PS3_CFG_LEGACY_ENV(name)
 *
 * File key:     [section] key = ...           (docs/CONFIG.md)
 * Environment:  PS3RECOMP_<SECTION>_<KEY>     (upper case)
 *
 * Adding an option: add a line here, add it to the table in docs/CONFIG.md.
 * Changing or removing one is a schema change: bump PS3_CONFIG_SCHEMA_VERSION in
 * config.h, because a file written for the old schema must be refused rather than
 * half-read.
 *
 * Section names must not be `hle` or `lv2`: those are the structured sections
 * ([[hle.stub]], [[lv2.stub]]) the loader parses separately.
 */

#ifndef PS3_CFG_BOOL
#  define PS3_CFG_BOOL(section, key, def, doc)
#  define PS3_CFG_BOOL_DEFAULTED
#endif
#ifndef PS3_CFG_U32
#  define PS3_CFG_U32(section, key, def, min, max, doc)
#  define PS3_CFG_U32_DEFAULTED
#endif
#ifndef PS3_CFG_STR
#  define PS3_CFG_STR(section, key, def, max_length, validator, doc)
#  define PS3_CFG_STR_DEFAULTED
#endif
#ifndef PS3_CFG_LEGACY_ENV
#  define PS3_CFG_LEGACY_ENV(name)
#  define PS3_CFG_LEGACY_ENV_DEFAULTED
#endif

/* ---- ppu ---------------------------------------------------------------- */

PS3_CFG_BOOL(ppu, vscr_nj, 1,
    "Initial VSCR[NJ] (non-Java mode: denormal vector-float inputs and results "
    "flush to zero) of every guest PPU context, applied when the context is "
    "created: the main thread, spawned threads and callback contexts. A guest "
    "mtvscr changes only its own context afterwards. The default is true for "
    "parity with RPCS3, which starts its PPU threads with NJ set. That is a "
    "policy, not a hardware fact: what the console's reset state and firmware "
    "leave in VSCR is not established.")

PS3_CFG_BOOL(ppu, opd_swap_fixup, 0,
    "Redirect an indirect call whose ctr is not a lifted function but whose r2 "
    "(the TOC register) is: the guest wrote a function descriptor as {toc, code} "
    "instead of {code, toc}, so the two words are swapped. Off by default. This "
    "compensates for a title's malformed descriptor (Odin Sphere's flOw-style "
    "handler tables and teardown vtables are written this way by func_0036FA74); "
    "a swapped OPD is not a PPC ABI guarantee and the redirect can silently run "
    "the wrong function. Off, the call stops as unresolved-indirect-call and its "
    "hint names this option.")

PS3_CFG_STR(ppu, null_page, "stop", 4, PS3_CFG_V_NULL_PAGE,
    "What a guest load or store into the null page does: \"stop\" (the default) "
    "ends the run at the first one with kind guest-null-access (access, width, "
    "ea, fn, and pc/lr/tid); \"drop\" keeps the legacy behaviour of titles that "
    "need it: a load logs [null-read] and returns what memory holds, a store "
    "logs [null-write] and is dropped, and a store sweep that starts in the "
    "null page (a memset on a null buffer) is dropped until it breaks off. The "
    "null page is [0, 0x10000) for loads and [0, 0x1000) for stores. Real "
    "hardware faults on every such access, so \"drop\" papers over a guest "
    "defect and lets the run continue on state the console never produced; a "
    "title config that sets it must say why in a comment.")

PS3_CFG_BOOL(ppu, precise_usleep, 1,
    "Make sys_timer_usleep wake on time on macOS: a sleep of 20 us or more waits on a kevent "
    "timer with NOTE_CRITICAL, which the kernel does not coalesce. nanosleep wakes late by a "
    "quarter of the request or more (2.5 ms at 10 ms, 4.0 ms at 16 ms, p50 on the measuring "
    "host), which makes a guest that paces itself with usleep(period - elapsed) miss its "
    "deadline; the console's usleep is accurate. The option changes no thread state (the "
    "QoS class and priority the runtime set stay), costs about 0.5 us a call and, if the host "
    "refuses the timer, logs [usleep] precise-usleep-fallback once and sleeps that call with "
    "nanosleep. Off is the nanosleep reference path, kept for A/B. Timing only, and only "
    "macOS: the Windows (waitable timer, QPC tail) and Linux (nanosleep) paths are unchanged "
    "and ignore it. Read once, at the first sleep.")

/* ---- spu ---------------------------------------------------------------- */

PS3_CFG_U32(spu, dma_repeat_limit, 256, 1, 4294967295,
    "How many identical MFC transfers (same EA and LSA, back to back) start the "
    "SPU DMA engine's back-off: it yields the thread for the first 2 ms of the "
    "episode, where a healthy poll ends, then sleeps 1 ms per repeat. The back-off "
    "is timing only: it stops the host from spinning while a job polls a value "
    "another agent writes. At the limit the engine only slows down; it does not "
    "halt the SPU.")

PS3_CFG_U32(spu, dma_repeat_stop_secs, 0, 0, 86400,
    "If non-zero, an SPU that has issued identical MFC transfers continuously "
    "for this many seconds stops with kind spu-dma-repeat (image, pc, ea, lsa, "
    "cmd, size, count, secs). 0 never stops: some jobs legitimately poll a ring "
    "or label for longer than any fixed deadline, and a wrong halt wedges the "
    "chain. This is a host watchdog, not PS3 hardware behaviour.")

PS3_CFG_BOOL(spu, mfc_lookup_cache, 1,
    "Remember, per host thread, the last SPU context whose MFC engine the thread "
    "looked up, so a repeated lookup for the same context skips the registry's "
    "read lock. Without it every MFC channel access takes that process-wide lock "
    "and walks the slot list, and with several SPU worker threads the lock word "
    "bounces between cores. A remembered engine is only returned while the "
    "registry is unchanged: every release or forget of an engine publishes a new "
    "generation that drops all remembered engines, and a generation counter that "
    "would wrap turns the cache off for the rest of the process. On by default: "
    "in one title's replay the lock took over half of a frame-queue worker's CPU "
    "and 99.7 % of lookups hit the cache (#88). Off is the "
    "reference path, every lookup under the lock. Timing only: both paths hand a "
    "context the same engine. Read once, at the first MFC access.")

/* ---- gcm ---------------------------------------------------------------- */

PS3_CFG_U32(gcm, wait_timeout_ms, 10000, 1, 3600000,
    "How long, in milliseconds, an RSX wait may stand unsatisfied before the run stops with kind "
    "gcm-wait-timeout: a NV406E semaphore acquire whose label never reaches the value, the "
    "command-context buffer-full callback waiting for the RSX to leave the next segment, a guest "
    "store to a label waiting for the RSX walker's next pass, or a self-JUMP park nobody patches "
    "(what=jump-park; see gcm.park_resync). The "
    "hardware waits forever; a wait that expires here means the agent that should end it (an SPU "
    "job writing a label, the driver, the walker) never ran. A host watchdog, not PS3 behaviour.")

PS3_CFG_BOOL(gcm, park_resync, 0,
    "Compatibility mode for a command-buffer park: a JUMP to itself that the guest patches later "
    "(Edge geometry jobs reserve holes this way; a title may append after the park, move put there and "
    "patch the park last). Off, the Reference behaviour: the RSX waits at the park for the patch, "
    "however late, and GET never moves to put because a host deadline expired; a park that stands the "
    "whole gcm.wait_timeout_ms with put elsewhere stops with kind gcm-wait-timeout (what=jump-park). "
    "On, a park that has stood gcm.park_grace_ms with put elsewhere and still unpatched moves GET to "
    "put and drops the commands in between, and every such intervention is logged with the mode and "
    "the effective grace. The commands it drops (a fence among them) were never executed, so this can "
    "stop a title that the Reference mode runs correctly; it exists for a title whose producer never "
    "patches the park. A host liveness policy, not PS3 behaviour.")

PS3_CFG_U32(gcm, park_grace_ms, 50, 1, 60000,
    "How long, in milliseconds, a self-JUMP park stands with put elsewhere before gcm.park_resync moves "
    "GET to put. Effective only with gcm.park_resync on; the Reference mode ignores it. God of War HD, "
    "loading its menu, took more than 50 ms between its append and its patch of the park, so a title "
    "that needs the Compatibility mode may need this longer.")

PS3_CFG_BOOL(gcm, handler_thread, 0,
    "Deliver the guest's vblank, flip and user handlers only on one dedicated host thread, as the "
    "PS3 does on its GCM interrupt thread. Off, the handlers run at an HLE boundary, nested in whatever "
    "guest thread made the call, and inherit its thread id: a handler that takes a lock that thread "
    "already holds re-enters it instead of waiting (MLB The Show 16's lock wrappers record the owner "
    "id and unlock only for the recorded owner; its flip handler, delivered inside its DisplayFlip "
    "thread, cleared that record and the lock leaked, freezing the game). The handlers then run "
    "concurrently with the guest threads, as on the console. Off by default: the guest-visible "
    "ordering of handler delivery changes, and no title but that one is known to need it. A "
    "compatibility mode, not PS3 behaviour of the runtime's own pump (v0.19.0 #647).")

PS3_CFG_U32(gcm, report_spu_hold_ms, 0, 0, 60000,
    "If non-zero, a GET_REPORT waits up to this many milliseconds while SPU tasks that work in "
    "signal-driven rounds are in one (spu_taskset_round_busy). The real RSX spends a frame's time "
    "drawing between two reports; the walker spends none, so a title that turns reports into task "
    "signals can signal the next round while the last one still runs, and a signal sent to a task "
    "that is still busy is taken by whatever wait it reaches next (God of War: Ascension's RsxSync). "
    "Like an ACQUIRE, a held report stops the drain pass without consuming the method. The hold "
    "gives up after this long with a logged line. 0 never holds. A compatibility timing policy, not "
    "PS3 behaviour (v0.19.0 #635).")

/* ---- eng (the RSX draw engine; PS3RECOMP_ENG_*) ------------------------- */

PS3_CFG_BOOL(eng, depth_clamp, 1,
    "Honour the depth-clamp field of NV4097_SET_ZMIN_MAX_CONTROL (0x1D78): a fragment beyond the near "
    "or far plane is clamped to it instead of clipped, as on the RSX. False always clips at the near "
    "and far planes, as before the register was honoured. On by default; a kill switch for diagnosing a title whose "
    "geometry changes with the clamp (v0.19.0 #693).")

PS3_CFG_BOOL(eng, depth_bounds, 1,
    "Emulate the depth-bounds test (NV4097_SET_DEPTH_BOUNDS_TEST_ENABLE with the min and max registers) "
    "on a backend with no native one: the draw's depth is snapshotted before it and the pixel is "
    "discarded outside the bounds. False ignores the test, as before. On by default; a kill switch for "
    "diagnosing a title that enables the test with bounds it does not mean (v0.19.0 #694).")

/* ---- game --------------------------------------------------------------- */

PS3_CFG_BOOL(game, free_space_raw, 0,
    "Report the host disk's measured free space to the guest in every cellGame hddFreeSizeKB, capped "
    "at INT32_MAX KB, instead of RPCS3's 40 GiB - 256 KiB once the measured value reaches 4 GiB. A "
    "guest computes hddFreeSizeKB * 1024 in 32 bits, so 4 GiB or more wraps to a few MB and the "
    "install check fails (inFAMOUS 2, with 41.7 GB free); the default keeps the measured value below "
    "4 GiB, where it cannot wrap, and reports RPCS3's figure above it. The figure above 4 GiB is "
    "RPCS3's, not a hardware measurement. On is for a title that must see the real number "
    "(v0.19.0 #692).")

/* ---- trophy ------------------------------------------------------------- */

PS3_CFG_U32(trophy, register_wait_cap_vblanks, 1024, 1, 16777216,
    "The most vblanks sceNpTrophyRegisterContext waits for its status events to "
    "be consumed by cellSysutilCheckCallback before it returns success anyway, "
    "counting and logging the cap (register-wait-cap). The firmware blocks until "
    "the VSH has finished installing; the HLE paces status delivery over 120 vblanks "
    "(2.0 s at 59.94 Hz). The HLE's own worst case with per-vblank polling is "
    "about 121 vblanks (120 vblanks of pacing plus the 1-vblank #37 return step), "
    "longer only if the title polls rarely. The default of 1024 vblanks leaves "
    "ample margin for slow pollers (RPCS3's oracle tolerates up to 50 ms grace per "
    "event). A title that registers on the thread that does the polling hits the cap, "
    "and the events are then delivered by its later polls.")

/* ---- video -------------------------------------------------------------- */

PS3_CFG_STR(video, resolutions, "", 31, PS3_CFG_V_VIDEO_RESOLUTIONS,
    "The resolutions the display reports as available, as a comma-separated list "
    "of cellVideoOut resolution ids: 1 (1080), 2 (720), 4 (480), 5 (576), "
    "10 (1600x1080), 11 (1440x1080), 12 (1280x1080), 13 (960x1080). "
    "cellVideoOutGetResolutionAvailability answers from it, "
    "cellVideoOutGetDeviceInfo lists exactly these modes, and the resolution "
    "cellVideoOutGetState reports before the title configures one is 720 when "
    "it is in the list, else the first of 480, 576, 720, 1080, 1600x1080, "
    "1440x1080, 1280x1080, 960x1080 that is. An id outside that set is a "
    "config error. Empty (the default) means no restriction: every id is "
    "reported available and the device lists 480, 576, 720 and 1080. A real "
    "console answers per connected display, so a list is a policy (for example "
    "to run a title at the resolution an oracle trace was recorded at), not a "
    "hardware fact.")

PS3_CFG_BOOL(video, rsx_capture, 0,
    "Record the RSX command stream and every guest-memory input the RSX consumes as a "
    "ps3diff.rsx/1 capture (docs/PS3DIFF.md) under video.rsx_capture_dir. Off by default: the "
    "FIFO walker and the draw engine then run exactly as before. The capture starts from "
    "cellGcmInit, so it needs the option set before the title's first RSX command; a "
    "walker that meets the first command without a GCM init stops with kind rsx-capture "
    "(reason=midstream). Capture copies and hashes every consumed span: expect a slower run.")

PS3_CFG_STR(video, rsx_capture_dir, "", 255, PS3_CFG_V_NONE,
    "The directory video.rsx_capture writes into (capture.ndjson and blobs/sha256/). It is "
    "created if missing and must not already hold a capture. Empty with video.rsx_capture on "
    "is a config error.")

PS3_CFG_U32(video, rsx_capture_frames, 0, 0, 1000000,
    "Close the capture after this many completed frames (flip heads) and stop capturing; the "
    "title keeps running. 0 captures until the process exits normally; a process that is "
    "killed leaves capture.ndjson.partial, which no tool accepts.")

/* ---- pad ---------------------------------------------------------------- */

PS3_CFG_STR(pad, record, "", 1023, PS3_CFG_V_PAD_RECORD_PATH,
    "Record what the guest is handed by cellPadGetData (and the connection state it is told by "
    "cellPadGetInfo/GetInfo2/cellPadPeriphGetInfo) into this file, as a ps3recomp-pad-trace the "
    "pad.replay option plays back (docs/MODULES_REFERENCE.md, \"cellPad: record and replay\"). "
    "The words are the ones stored to guest memory, after the host pad, the keyboard and the "
    "PAD_SCRIPT, PAD_FILE, PAD_STICK and PAD_AUTOPRESS injectors, keyed by (flip, poll); only a "
    "change of state is written. The file is created and never overwritten: a path that exists, "
    "or one in a directory that is missing or not writable, is a config error. Empty (the "
    "default) records nothing. May be set together with pad.replay to record the replayed input.")

PS3_CFG_STR(pad, replay, "", 1023, PS3_CFG_V_PAD_REPLAY_PATH,
    "Play back a pad trace recorded with pad.record: every cellPadGetData answers with the "
    "recorded state of the latest record at or before the poll's (flip, poll), a neutral pad "
    "before the first record of a port and after the end of the trace, and the info calls report "
    "the recorded connection. The host pad and every injector are ignored. A malformed file, an "
    "unknown version or keys that go backwards end the run with kind pad-trace; a path that is "
    "not a readable file is a config error. A summary of how closely the guest followed the "
    "recording is printed at the end of the trace and at exit. Empty (the default) plays back "
    "nothing.")

/* ---- title -------------------------------------------------------------- */

PS3_CFG_STR(title, elf_sha256, "", 64, PS3_CFG_V_SHA256_OR_EMPTY,
    "Optional pin on the executable ppu_load_elf may load: its SHA-256 as 64 hex "
    "digits (either case). Checked in addition to the hash the lifter recorded "
    "in the lifted output, never instead of it. Empty means no pin.")

/* ---- diag --------------------------------------------------------------- */

PS3_CFG_BOOL(diag, dump_config, 0,
    "Print the effective configuration (every key, its value and where the value "
    "came from) to stderr once it is loaded.")

/* ---- legacy environment variables --------------------------------------- */
/*
 * Existing diagnostic knobs that read PS3RECOMP_* straight from the environment
 * and are not (yet) options. The environment loader treats every other
 * PS3RECOMP_* variable as a typo and stops, so each one that is still read
 * elsewhere has to be listed or running a title with it set would stop. Moving
 * one into the registry is how it leaves this list.
 */

/* runtime diagnostics and backends (libs/) */
PS3_CFG_LEGACY_ENV("PS3RECOMP_ENG_TEXHASH_FULL")
PS3_CFG_LEGACY_ENV("PS3RECOMP_FFMPEG")
PS3_CFG_LEGACY_ENV("PS3RECOMP_FFMPEG_AVCODEC")
PS3_CFG_LEGACY_ENV("PS3RECOMP_FFMPEG_AVUTIL")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FIXED_FUNCTION")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FPS")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FRAME_DUMP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FRAME_DUMP_LIST")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FRAME_DUMP_RANGE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_HEADLESS")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_MRT_MASK")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_SHADER_DUMP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_MSL_FAST")
PS3_CFG_LEGACY_ENV("PS3RECOMP_RSX_ENGINE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_SPIRV_CACHE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DEVICE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DUMP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DUMP_EVERY")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_FULLSCREEN")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_GUEST_PROGRAMS")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_HOLD")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_WINDOW")
/* tool-side (tools/): exported in the same shells that run a title */
PS3_CFG_LEGACY_ENV("PS3RECOMP_DIR")
PS3_CFG_LEGACY_ENV("PS3RECOMP_ARCHIVE_ROOT")
PS3_CFG_LEGACY_ENV("PS3RECOMP_PSN_ROOT")
PS3_CFG_LEGACY_ENV("PS3RECOMP_OUT")
PS3_CFG_LEGACY_ENV("PS3RECOMP_7ZIP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_PS3SCE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_IDA_PYTHON")

