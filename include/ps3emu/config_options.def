/*
 * ps3recomp - the typed option registry: ONE list, many consumers.
 *
 * Every behavioural option of the runtime is declared here, once. include/
 * ps3emu/config.h expands it into the typed storage and the C accessors,
 * runtime/config/config.cpp into the metadata, the file/environment parsers and
 * the effective-config dump. Nothing else may read a behavioural option by name:
 * call sites use the generated accessor, so a typo is a compile error rather
 * than a silently ignored string.
 *
 *   PS3_CFG_BOOL(section, key, default, doc)
 *   PS3_CFG_U32(section, key, default, min, max, doc)
 *   PS3_CFG_STR(section, key, default, max_length, validator, doc)
 *   PS3_CFG_LEGACY_ENV(name)
 *
 * File key:     [section] key = ...           (docs/CONFIG.md)
 * Environment:  PS3RECOMP_<SECTION>_<KEY>     (upper case)
 *
 * Adding an option: add a line here, add it to the table in docs/CONFIG.md.
 * Changing or removing one is a schema change: bump PS3_CONFIG_SCHEMA_VERSION in
 * config.h, because a file written for the old schema must be refused rather than
 * half-read.
 *
 * Section names must not be `hle` or `lv2`: those are the structured sections
 * ([[hle.stub]], [[lv2.stub]]) the loader parses separately.
 */

#ifndef PS3_CFG_BOOL
#  define PS3_CFG_BOOL(section, key, def, doc)
#  define PS3_CFG_BOOL_DEFAULTED
#endif
#ifndef PS3_CFG_U32
#  define PS3_CFG_U32(section, key, def, min, max, doc)
#  define PS3_CFG_U32_DEFAULTED
#endif
#ifndef PS3_CFG_STR
#  define PS3_CFG_STR(section, key, def, max_length, validator, doc)
#  define PS3_CFG_STR_DEFAULTED
#endif
#ifndef PS3_CFG_LEGACY_ENV
#  define PS3_CFG_LEGACY_ENV(name)
#  define PS3_CFG_LEGACY_ENV_DEFAULTED
#endif

/* ---- ppu ---------------------------------------------------------------- */

PS3_CFG_BOOL(ppu, vscr_nj, 1,
    "Initial VSCR[NJ] (non-Java mode: denormal vector-float inputs and results "
    "flush to zero) of every guest PPU context, applied when the context is "
    "created: the main thread, spawned threads and callback contexts. A guest "
    "mtvscr changes only its own context afterwards. The default is true for "
    "parity with RPCS3, which starts its PPU threads with NJ set. That is a "
    "policy, not a hardware fact: what the console's reset state and firmware "
    "leave in VSCR is not established.")

PS3_CFG_BOOL(ppu, opd_swap_fixup, 0,
    "Redirect an indirect call whose ctr is not a lifted function but whose r2 "
    "(the TOC register) is: the guest wrote a function descriptor as {toc, code} "
    "instead of {code, toc}, so the two words are swapped. Off by default. This "
    "compensates for a title's malformed descriptor (flOw-style "
    "handler tables and teardown vtables are written this way by func_0036FA74); "
    "a swapped OPD is not a PPC ABI guarantee and the redirect can silently run "
    "the wrong function. Off, the call stops as unresolved-indirect-call and its "
    "hint names this option.")

PS3_CFG_STR(ppu, null_page, "stop", 4, PS3_CFG_V_NULL_PAGE,
    "What a guest load or store into the null page does: \"stop\" (the default) "
    "ends the run at the first one with kind guest-null-access (access, width, "
    "ea, fn, and pc/lr/tid); \"drop\" keeps the legacy behaviour of titles that "
    "need it: a load logs [null-read] and returns what memory holds, a store "
    "logs [null-write] and is dropped, and a store sweep that starts in the "
    "null page (a memset on a null buffer) is dropped until it breaks off. The "
    "null page is [0, 0x10000) for loads and [0, 0x1000) for stores. Real "
    "hardware faults on every such access, so \"drop\" papers over a guest "
    "defect and lets the run continue on state the console never produced; a "
    "title config that sets it must say why in a comment.")

PS3_CFG_BOOL(ppu, precise_usleep, 1,
    "Make sys_timer_usleep wake on time on macOS: a sleep of 20 us or more waits on a kevent "
    "timer with NOTE_CRITICAL, which the kernel does not coalesce. nanosleep wakes late by a "
    "quarter of the request or more (2.5 ms at 10 ms, 4.0 ms at 16 ms, p50 on the measuring "
    "host), which makes a guest that paces itself with usleep(period - elapsed) miss its "
    "deadline; the console's usleep is accurate. The option changes no thread state (the "
    "QoS class and priority the runtime set stay), costs about 0.5 us a call and, if the host "
    "refuses the timer, logs [usleep] precise-usleep-fallback once and sleeps that call with "
    "nanosleep. Off is the nanosleep reference path, kept for A/B. Timing only, and only "
    "macOS: the Windows (waitable timer, QPC tail) and Linux (nanosleep) paths are unchanged "
    "and ignore it. Read once, at the first sleep.")

PS3_CFG_BOOL(ppu, poll_sleep_coalesce, 0,
    "Honour the usleep-site seams a title registers (ps3_usleep_site_register, runtime/syscalls/sys_timer.h): a "
    "guest that paces itself with a loop of short usleep calls against a deadline the title can compute (the "
    "frame limiter's usleep(30) poll, 350-400 calls and ~26000 host wakeups a frame) sleeps once to that "
    "deadline instead, spinning the last ppu.poll_sleep_spin_us. The guest's own branches, loads and stores "
    "are unchanged; what changes is how many times it reads the clock and the instant the loop ends, which "
    "no longer overshoots by the poll's own 17 us (a frame limiter then ticks 0.1 % faster). A sleep never "
    "runs past the bound the title registered, a deadline that is past, zero or beyond the bound takes the "
    "ordinary usleep, and a pending GCM notification ends the sleep early (the handler is delivered as soon as "
    "a poll would deliver it, then the sleep resumes). A flip-wait site (ps3_usleep_flip_wait_register: a guest "
    "loop that polls the GCM flip status with short usleep calls until it reads DONE) sleeps until that status "
    "is DONE or the site's cap, whichever is first, then returns to the guest, which reads the status again "
    "itself: nothing it reads or writes changes, only the number of syscalls and the instant of its next look. "
    "Off by default, and with it off a registered site is ignored. "
    "POSIX hosts only: Windows keeps the ordinary path, because its guest clock has a different base. Read "
    "once, at the first sleep.")

PS3_CFG_U32(ppu, poll_sleep_spin_us, 100, 0, 2000,
    "With ppu.poll_sleep_coalesce: how many microseconds before the deadline the sleep ends and the thread "
    "spins on the host clock to it. A kernel timer wakes 20-50 us late (p95 66 us on an M4 Pro), so a sleep "
    "to the deadline itself exits after it; the spin trades that jitter for CPU (about 80 us a frame at "
    "100). 0 is a pure sleep. The wake latency of a small core is not measured: raise it there. Read "
    "once, at the first sleep.")

PS3_CFG_U32(ppu, host_stack_mb, PS3_CFG_PPU_HOST_STACK_MB_DEFAULT, 1, 2048,
    "Host stack, in MiB, reserved for every thread that runs guest PPU code on a host thread of its own: the "
    "guest PPU threads the title creates (not the main thread), the GCM interrupt thread (guest vblank, flip and "
    "queue handlers) and the video decoder's idle thread (cellVdec). Each "
    "recompiled guest call is a real host call, so a deep guest call chain nests on this stack; it is address "
    "space reserved up front and committed by the OS as the thread touches it. The default is 256 on macOS, "
    "Linux and Windows and 32 on iOS, where the app's address space is small and 256 MiB per thread was refused "
    "41-86 times a run and starved later Metal allocations; the iOS value is provisional until a device run's "
    "per-thread high-water report (env PS3_HOST_STACK_HWM=1, docs/DIAGNOSTICS.md) says what the guest uses. A "
    "thread that overflows a stack too small for it dies with a fault, so lower it only from a measured "
    "high-water mark. A host that refuses the reservation ends the run with kind host-thread-stack; the thread "
    "is never started on the host's default stack. Read when each thread is created.")

/* ---- spu ---------------------------------------------------------------- */

PS3_CFG_U32(spu, host_stack_mb, PS3_CFG_SPU_HOST_STACK_MB_DEFAULT, 1, 1024,
    "Host stack, in MiB, reserved for every host thread that runs lifted SPU code except the async-dispatch "
    "threads (spu.dispatch_stack_mb): SPU thread group members, raw SPUs, the SPURS policy-module workers and "
    "job chains, the JobQueue2 workers and the xdiff audit thread. Lifted SPU code turns a guest loop into a "
    "chain of host calls, so a thread on the host's default stack (512 KiB on Darwin) dies inside code that did "
    "nothing wrong. The default is 16 on macOS, Linux and Windows and 8 on iOS: one SPURS instance, one JobQueue2 "
    "queue, six raw SPUs and six group members is about 27 such threads, and 8 MiB each is the address space "
    "the threads that used 1-8 MiB reserved before, where 16 MiB each would add about 215 MB to an app whose "
    "address space is small. Raise it to chase a runaway chain: it replaces the environment variable "
    "SPU_HOST_STACK_BIG (512 MiB), which is no longer read. A host that refuses the reservation ends the run "
    "with kind host-thread-stack. Read when each thread is started.")

PS3_CFG_U32(spu, dispatch_stack_mb, PS3_CFG_SPU_DISPATCH_STACK_MB_DEFAULT, 1, 2048,
    "Host stack, in MiB, reserved for every async-dispatch thread: the host thread that runs a SPURS task or "
    "workload policy module image through its lifted entry (runtime/spu/spu_workload.c). The Bink SPU decoder's "
    "per-macroblock brsl chains are deep host call chains with fat lifted frames, and a 1 MiB stack blew the "
    "guard page, so the default is the 256 on macOS, Linux and Windows that has always been reserved. On iOS "
    "it is 32, for the same address-space reason as ppu.host_stack_mb, and provisional like it until a device "
    "run's high-water report (env PS3_HOST_STACK_HWM=1, docs/DIAGNOSTICS.md) says what these threads use. A host "
    "that refuses the reservation ends the run with kind host-thread-stack (role=spu-dispatch); the thread is "
    "never started on the host's default stack. Read when each thread is created.")

PS3_CFG_U32(spu, dma_repeat_limit, 256, 1, 4294967295,
    "How many identical MFC transfers (same EA and LSA, back to back) start the "
    "SPU DMA engine's back-off: it yields the thread for the first 2 ms of the "
    "episode, where a healthy poll ends, then sleeps 1 ms per repeat. The back-off "
    "is timing only: it stops the host from spinning while a job polls a value "
    "another agent writes. At the limit the engine only slows down; it does not "
    "halt the SPU.")

PS3_CFG_U32(spu, dma_repeat_stop_secs, 0, 0, 86400,
    "If non-zero, an SPU that has issued identical MFC transfers continuously "
    "for this many seconds stops with kind spu-dma-repeat (image, pc, ea, lsa, "
    "cmd, size, count, secs). 0 never stops: some jobs legitimately poll a ring "
    "or label for longer than any fixed deadline, and a wrong halt wedges the "
    "chain. This is a host watchdog, not PS3 hardware behaviour.")


PS3_CFG_STR(spu, job_body, "interp", 6, PS3_CFG_V_JOB_BODY,
    "Which body runs a JobQueue2 job (docs/SPU_XDIFF.md sections 3, 4 and 11): \"interp\" (the default) "
    "always the SPU interpreter, so a lifted body registered with spu_workload_register_img never runs "
    "here; \"lifted\" the body registered for the job's image when there is one AND the image is "
    "promoted (spu_workload_promote_img: registration alone is enough to capture an image and to replay "
    "it offline, promotion says a corpus proved the body), the interpreter for any other job. The "
    "image is identified by the bytes the loader staged, after staging (FNV-1a-64 of "
    "the sizeBinary << 4 bytes, remembered per worker by address, size and a word-wise content hash), "
    "never by the descriptor's address: a different binary staged at the same address and size runs "
    "interpreted. A hit of that memory is a claim, not a proof (section 4). A title's own "
    "ExecutorHooks::select_body, when it returns a body, still wins and is not checked against the "
    "bytes. Identification costs one content hash a job, and its byte-serial fingerprint when the "
    "worker has not seen those bytes; \"interp\" pays it only while tracing (kind 29), fixture "
    "capture or spu.xdiff is on. A lifted body is a different implementation of the same program, not a "
    "guarantee: run xdiff on a corpus before relying on it. Read once, at the first job.")

PS3_CFG_STR(spu, xdiff_dir, "", 1023, PS3_CFG_V_NONE,
    "The directory SPU job fixtures (docs/SPU_XDIFF.md, ps3recomp.spujob/1) are written into, "
    "one file per job, named <image fingerprint>-q<queue>-s<seq>.spujob. Empty (the default) "
    "writes none. The directory must exist and be writable: the runtime does not create it, "
    "and a fixture that cannot be written is one named diagnostic line "
    "([jq2-xdiff] capture-failed or differ, with the image, the reason and the detail) while the "
    "job and the run go on. Written by spu.xdiff_capture (the first N jobs of each image) and by "
    "spu.xdiff (a fixture with a VRDT section for a difference, at most 16 per image).")

PS3_CFG_U32(spu, xdiff_capture, 0, 0, 4294967295,
    "Record the first N jobs of each registered SPU job image into spu.xdiff_dir, for a corpus "
    "an offline replay can compare tiers on (JobQueue2 workers; docs/SPU_XDIFF.md section 11, "
    "commit 10a). 0 (the default) records nothing and the job path is unchanged. Only an image "
    "whose registration carries an effects inventory with no event branches is recorded, and "
    "only while the body that runs is the interpreter or the body registered for the image; "
    "any other job, including one of an image registered without an inventory, is counted "
    "ineligible and named once per address, size and reason, never recorded. A worker remembers "
    "the last four contents staged at an address. Unresolved MFC command sites do not refuse an image "
    "(same-program replay does not depend on a command's class); the fixtures of such an image "
    "are counted apart. The recorder is a tap on the effect port: it copies every effect and "
    "the entry and end local store on the worker that runs the job and adds the cost of those "
    "copies and one file write per fixture, but changes nothing the job reads or writes. A "
    "fixture's payload is bounded (64 MiB): a job that passes it is a counted capture-limit "
    "failure and the run goes on. The two options are read once, when the first JobQueue2 queue "
    "is created: with N > 0 and an empty or unusable spu.xdiff_dir (missing, not a directory, "
    "not writable) one line says so and nothing is recorded for the process. Recording perturbs "
    "timing: benchmarks run with 0.")

PS3_CFG_STR(spu, xdiff, "off", 6, PS3_CFG_V_XDIFF_MODE,
    "Whether the other tier shadows a JobQueue2 job (docs/SPU_XDIFF.md section 11): \"off\" (the "
    "default) runs nothing beside the job, \"sample\" records every spu.xdiff_period-th job of an "
    "image and checks it on an audit thread below normal priority, never waiting for it (a full "
    "queue drops the sample and counts it), \"all\" records every job and the workers wait for "
    "queue room. The authority is the body that runs (spu.job_body); the shadow is the other tier, "
    "run in process on the authority's recorded world with every effect served from the "
    "transcript. A lifted shadow runs only through the image's budgeted twin: an image without "
    "one is counted not eligible. The authority's result is always the one the guest sees; a "
    "difference never changes the run unless spu.xdiff_on_divergence or spu.xdiff_on_latent "
    "says stop. Only an image whose registration carries an effects inventory with no event "
    "branches is shadowed, as for spu.xdiff_capture. Recording perturbs timing: benchmarks run "
    "with \"off\". Read once, when the first JobQueue2 queue is created.")

PS3_CFG_U32(spu, xdiff_period, 64, 1, 4294967295,
    "With spu.xdiff = \"sample\": every N-th job of an image is shadowed, counted per image from "
    "its first job (jobs 1, N+1, 2N+1, ...). 1 shadows every job. Ignored for \"all\" and \"off\". "
    "Read once, when the first JobQueue2 queue is created.")

PS3_CFG_STR(spu, xdiff_on_divergence, "report", 6, PS3_CFG_V_XDIFF_ACTION,
    "What a visible difference between the authority and the shadow does to the run "
    "(docs/SPU_XDIFF.md sections 8.4 and 11): \"report\" (the default) names it on standard "
    "error, counts it and writes a fixture with the verdict when spu.xdiff_dir is set; \"stop\" "
    "also ends the run with kind spu-xdiff-divergence from the audit thread, after the job was "
    "credited. A visible difference is one the world saw: every effect difference, a different "
    "end class, and an end register or local store difference the loader keeps. A void verdict "
    "(budget, capture limit, a stop inside the shadow, ...) never stops a run. Read once, when "
    "the first JobQueue2 queue is created.")

PS3_CFG_STR(spu, xdiff_on_latent, "report", 6, PS3_CFG_V_XDIFF_ACTION,
    "What a latent difference does to the run: \"report\" (the default) or \"stop\" as for "
    "spu.xdiff_on_divergence. A latent difference is an end register or local store difference "
    "in state the JobQueue2 loader destroys (docs/SPU_XDIFF.md section 8.4); it is a defect of the "
    "lift the input did not expose, and blocks promotion exactly like a visible one. Read once, "
    "when the first JobQueue2 queue is created.")

PS3_CFG_U32(spu, xdiff_budget, 268435456, 1, 4294967295,
    "The shadow's budget before a void verdict with reason budget (docs/SPU_XDIFF.md section 10): "
    "interpreted instructions for a T0 shadow, backward and cross-function transfers of the "
    "image's budgeted twin for a lifted one. It bounds a loop with no effects, which no "
    "transcript ends. Read once, when the first JobQueue2 queue is created.")

/* ---- gcm ---------------------------------------------------------------- */

PS3_CFG_U32(gcm, wait_timeout_ms, 10000, 1, 3600000,
    "How long, in milliseconds, an RSX wait may stand unsatisfied before the run stops with kind "
    "gcm-wait-timeout: a NV406E semaphore acquire whose label never reaches the value, the "
    "command-context buffer-full callback waiting for the RSX to leave the next segment, a guest "
    "store to a label waiting for the RSX walker's next pass, or a self-JUMP park nobody patches "
    "(what=jump-park; see gcm.park_resync). The "
    "hardware waits forever; a wait that expires here means the agent that should end it (an SPU "
    "job writing a label, the driver, the walker) never ran. A host watchdog, not PS3 behaviour.")

PS3_CFG_BOOL(gcm, park_resync, 0,
    "Compatibility mode for a command-buffer park: a JUMP to itself that the guest patches later "
    "(Edge geometry jobs reserve holes this way; a title may append after the park, move put there and "
    "patch the park last). Off, the Reference behaviour: the RSX waits at the park for the patch, "
    "however late, and GET never moves to put because a host deadline expired; a park that stands the "
    "whole gcm.wait_timeout_ms with put elsewhere stops with kind gcm-wait-timeout (what=jump-park). "
    "On, a park that has stood gcm.park_grace_ms with put elsewhere and still unpatched moves GET to "
    "put and drops the commands in between, and every such intervention is logged with the mode and "
    "the effective grace. The commands it drops (a fence among them) were never executed, so this can "
    "stop a title that the Reference mode runs correctly; it exists for a title whose producer never "
    "patches the park. A host liveness policy, not PS3 behaviour.")

PS3_CFG_U32(gcm, park_grace_ms, 50, 1, 60000,
    "How long, in milliseconds, a self-JUMP park stands with put elsewhere before gcm.park_resync moves "
    "GET to put. Effective only with gcm.park_resync on; the Reference mode ignores it. God of War HD, "
    "loading its menu, took more than 50 ms between its append and its patch of the park, so a title "
    "that needs the Compatibility mode may need this longer.")

PS3_CFG_BOOL(gcm, handler_thread, 0,
    "Deliver the guest's vblank, flip and user handlers only on one dedicated host thread, as the "
    "PS3 does on its GCM interrupt thread. Off, the handlers run at an HLE boundary, nested in whatever "
    "guest thread made the call, and inherit its thread id: a handler that takes a lock that thread "
    "already holds re-enters it instead of waiting (MLB The Show 16's lock wrappers record the owner "
    "id and unlock only for the recorded owner; its flip handler, delivered inside its DisplayFlip "
    "thread, cleared that record and the lock leaked, freezing the game). The handlers then run "
    "concurrently with the guest threads, as on the console. Off by default: the guest-visible "
    "ordering of handler delivery changes, and no title but that one is known to need it. A "
    "compatibility mode, not PS3 behaviour of the runtime's own pump (v0.19.0 #647).")

PS3_CFG_U32(gcm, report_spu_hold_ms, 0, 0, 60000,
    "If non-zero, a GET_REPORT waits up to this many milliseconds while SPU tasks that work in "
    "signal-driven rounds are in one (spu_taskset_round_busy). The real RSX spends a frame's time "
    "drawing between two reports; the walker spends none, so a title that turns reports into task "
    "signals can signal the next round while the last one still runs, and a signal sent to a task "
    "that is still busy is taken by whatever wait it reaches next (God of War: Ascension's RsxSync). "
    "Like an ACQUIRE, a held report stops the drain pass without consuming the method. The hold "
    "gives up after this long with a logged line. 0 never holds. A compatibility timing policy, not "
    "PS3 behaviour (v0.19.0 #635).")

/* ---- eng (the RSX draw engine; PS3RECOMP_ENG_*) ------------------------- */

PS3_CFG_BOOL(eng, depth_clamp, 1,
    "Honour the depth-clamp field of NV4097_SET_ZMIN_MAX_CONTROL (0x1D78): a fragment beyond the near "
    "or far plane is clamped to it instead of clipped, as on the RSX. False always clips at the near "
    "and far planes, as before the register was honoured. On by default; a kill switch for diagnosing a title whose "
    "geometry changes with the clamp (v0.19.0 #693).")

PS3_CFG_BOOL(eng, depth_bounds, 1,
    "Emulate the depth-bounds test (NV4097_SET_DEPTH_BOUNDS_TEST_ENABLE with the min and max registers) "
    "on a backend with no native one: the draw's depth is snapshotted before it and the pixel is "
    "discarded outside the bounds. False ignores the test, as before. On by default; a kill switch for "
    "diagnosing a title that enables the test with bounds it does not mean (v0.19.0 #694).")

/* ---- rsx (the RSX backends' own policies; PS3RECOMP_RSX_*) -------------- */

PS3_CFG_STR(rsx, bc_path, "auto", 6, PS3_CFG_V_BC_PATH,
    "How the Metal backend holds a guest BC1/2/3 (DXT1-5) texture. \"auto\" (the default): as BC where the "
    "device samples BC, otherwise decoded to RGBA8 by the toolkit (an iOS device whose GPU reports no BC "
    "sampling, MTLDevice.supportsBCTextureCompression; the iPhone X is the floor). The other values decode on every device, a BC-capable "
    "Mac included, which is what measuring a tier and the end-to-end frame comparison need: \"cpu\" decodes "
    "each level on the RSX thread (libs/video/rsx_bc_decode.c); \"gpu\" decodes every level of a texture "
    "created by the upload with a compute kernel, in a command buffer committed before the frame's (a "
    "texture an upload only refreshes takes the CPU tier, after the decodes pending for it); \"tiered\" is "
    "cpu for a texture whose largest level has fewer than rsx.bc_gpu_min_texels texels and gpu from there "
    "on, all its levels alike. Both tiers write exactly the texels the Apple GPU's own BC "
    "decode produces, so the choice changes only where the time goes, not a pixel (docs/CONFIG.md). Decoded "
    "textures are 8x (BC1) or 4x (BC2, BC3) larger. Exception: the Metal vtable route (macOS only: "
    "PS3RECOMP_RSX_ENGINE=vtable, or a draw engine that did not start) has no decoder and holds BC natively, so "
    "a forced value (cpu, gpu, tiered) there ends the run with kind config-invalid naming this key and the "
    "route; \"auto\" goes on natively. A GPU-tier decode whose command buffer fails ends the run with kind "
    "host-gpu-command at the next frame commit; so does one still pending after the commit's wait of "
    "8 s of active time (reason=decode-timeout). Read once, at the first BC texture.")

PS3_CFG_U32(rsx, bc_gpu_min_texels, 147456, 1, 4294967295,
    "With rsx.bc_path = \"tiered\" (and \"auto\" where it decodes): the number of texels of a texture's "
    "largest level (its creation size, width times height), from which the GPU tier decodes the whole "
    "texture, every level, cube face and slice. A smaller texture is decoded entirely on the RSX thread, "
    "which costs it less than staging, submitting and waiting for before the frame commits (the GPU's "
    "latency, about 0.1 ms on an M4 Pro, is the floor); a texture never mixes the tiers, so the CPU never "
    "writes a texture the GPU is writing. PROVISIONAL: the first size where the GPU tier is cheaper on the "
    "RSX thread counting that wait, measured on an Apple M4 Pro (tests/bench/video/bench_rsx_bc_gpu.m, per "
    "level), not yet on an iPhone X; revisit with the PS3_FTRACE BC_UPLOAD and BC_SETTLE spans (kinds 34, 35) "
    "of a device run. Ignored by \"cpu\" and \"gpu\". Read once, at the first BC texture.")

/* ---- vk (the Vulkan backend; PS3RECOMP_VK_*) ---------------------------- */

PS3_CFG_BOOL(vk, draw_batch, 0,
    "Record the draw engine's draws, snapshots, texture uploads and clears into one Vulkan command "
    "buffer per submission instead of a submit and a fence wait for each (libs/video/"
    "rsx_vulkan_backend.c, \"Draw batching\"). The vertex, index and uniform data of every draw "
    "sit in host-coherent rings, and a full memory barrier between recorded draws keeps "
    "render-to-texture ordering; the batch is submitted and waited for at a present, a readback, an "
    "object destroy, a full ring or vk.draw_batch_max operations. It is meant to change only when "
    "work is submitted, not what is drawn; off by default until a pixel diff of presented frames, "
    "on against off, is clean (#129). The rings are 176 MiB of host-visible memory (vertex 64, "
    "index 16, uniform 32, upload staging 64), and a device that cannot give host-coherent memory "
    "for them stays off with a logged line. Read once, when the draw engine first draws. Replaces "
    "the environment switch VK_DRAW_BATCH=1.")

PS3_CFG_U32(vk, draw_batch_max, 512, 1, 1024,
    "The most operations (draws, snapshots, uploads, clears) recorded into one batched submission "
    "when vk.draw_batch is on. 1024 is the descriptor pool's set count, so a larger value could not "
    "be honoured: it is a config error, where VK_DRAW_BATCH_MAX once capped it silently. Read once, "
    "with vk.draw_batch. Replaces the environment variable VK_DRAW_BATCH_MAX.")

/* ---- game --------------------------------------------------------------- */

PS3_CFG_BOOL(game, free_space_raw, 0,
    "Report the host disk's measured free space to the guest in every cellGame hddFreeSizeKB, capped "
    "at INT32_MAX KB, instead of RPCS3's 40 GiB - 256 KiB once the measured value reaches 4 GiB. A "
    "guest computes hddFreeSizeKB * 1024 in 32 bits, so 4 GiB or more wraps to a few MB and the "
    "install check fails (inFAMOUS 2, with 41.7 GB free); the default keeps the measured value below "
    "4 GiB, where it cannot wrap, and reports RPCS3's figure above it. The figure above 4 GiB is "
    "RPCS3's, not a hardware measurement. On is for a title that must see the real number "
    "(v0.19.0 #692).")

/* ---- trophy ------------------------------------------------------------- */

PS3_CFG_U32(trophy, register_wait_cap_vblanks, 1024, 1, 16777216,
    "The most vblanks sceNpTrophyRegisterContext waits for its status events to "
    "be consumed by cellSysutilCheckCallback before it returns success anyway, "
    "counting and logging the cap (register-wait-cap). The firmware blocks until "
    "the VSH has finished installing; the HLE paces status delivery over 120 vblanks "
    "(2.0 s at 59.94 Hz). The HLE's own worst case with per-vblank polling is "
    "about 121 vblanks (120 vblanks of pacing plus the 1-vblank #37 return step), "
    "longer only if the title polls rarely. The default of 1024 vblanks leaves "
    "ample margin for slow pollers (RPCS3's oracle tolerates up to 50 ms grace per "
    "event). A title that registers on the thread that does the polling hits the cap, "
    "and the events are then delivered by its later polls.")

/* ---- adec --------------------------------------------------------------- */

PS3_CFG_BOOL(adec, silence_fallback, 0,
    "Let cellAdecDecodeAu answer an AU it has no decoder for (every codec but AC3; AC3 without "
    "FFmpeg, with PS3RECOMP_FFMPEG=0, or when libavcodec decodes nothing from it) with CELL_OK and "
    "a block of silence of the codec's frame size, AUDONE and PCMOUT as for a decoded AU. Off, the "
    "default: that AU ends the run with kind adec-no-decoder (func, codec, reason), because the "
    "console decodes it and reporting success for audio that was never decoded hides the gap. The "
    "silence keeps a title that only counts PCM against time running (a movie player, a CD-DA "
    "reader); a title config that sets it must say why in a comment, and which codec it covers.")

/* ---- video -------------------------------------------------------------- */

PS3_CFG_STR(video, resolutions, "", 31, PS3_CFG_V_VIDEO_RESOLUTIONS,
    "The resolutions the display reports as available, as a comma-separated list "
    "of cellVideoOut resolution ids: 1 (1080), 2 (720), 4 (480), 5 (576), "
    "10 (1600x1080), 11 (1440x1080), 12 (1280x1080), 13 (960x1080). "
    "cellVideoOutGetResolutionAvailability answers from it, "
    "cellVideoOutGetDeviceInfo lists exactly these modes, and the resolution "
    "cellVideoOutGetState reports before the title configures one is 720 when "
    "it is in the list, else the first of 480, 576, 720, 1080, 1600x1080, "
    "1440x1080, 1280x1080, 960x1080 that is. An id outside that set is a "
    "config error. Empty (the default) means no restriction: every id is "
    "reported available and the device lists 480, 576, 720 and 1080. A real "
    "console answers per connected display, so a list is a policy (for example "
    "to run a title at the resolution an oracle trace was recorded at), not a "
    "hardware fact.")

PS3_CFG_BOOL(video, rsx_capture, 0,
    "Record the RSX command stream and every guest-memory input the RSX consumes as a "
    "ps3diff.rsx/2 capture (docs/PS3DIFF.md; /1 captures remain readable) under video.rsx_capture_dir. Off by default: the "
    "FIFO walker and the draw engine then run exactly as before. The capture starts from "
    "cellGcmInit, so it needs the option set before the title's first RSX command; a "
    "walker that meets the first command without a GCM init stops with kind rsx-capture "
    "(reason=midstream). Capture copies and hashes every consumed span: expect a slower run.")

PS3_CFG_STR(video, rsx_capture_dir, "", 255, PS3_CFG_V_NONE,
    "The directory video.rsx_capture writes into (capture.ndjson and blobs/sha256/). It is "
    "created if missing and must not already hold a capture. Empty with video.rsx_capture on "
    "is a config error.")

PS3_CFG_U32(video, rsx_capture_frames, 0, 0, 1000000,
    "Close the capture after this many completed frames (flip heads) and stop capturing; the "
    "title keeps running. 0 captures until the process exits normally; a process that is "
    "killed leaves capture.ndjson.partial, which no tool accepts.")

/* ---- pad ---------------------------------------------------------------- */

PS3_CFG_STR(pad, record, "", 1023, PS3_CFG_V_PAD_RECORD_PATH,
    "Record what the guest is handed by cellPadGetData (and the connection state it is told by "
    "cellPadGetInfo/GetInfo2/cellPadPeriphGetInfo) into this file, as a ps3recomp-pad-trace the "
    "pad.replay option plays back (docs/MODULES_REFERENCE.md, \"cellPad: record and replay\"). "
    "The words are the ones stored to guest memory, after the host pad, the keyboard and the "
    "PAD_SCRIPT, PAD_FILE, PAD_STICK and PAD_AUTOPRESS injectors, keyed by (flip, poll); only a "
    "change of state is written. The file is created and never overwritten: a path that exists, "
    "or one in a directory that is missing or not writable, is a config error. Empty (the "
    "default) records nothing. May be set together with pad.replay to record the replayed input.")

PS3_CFG_STR(pad, replay, "", 1023, PS3_CFG_V_PAD_REPLAY_PATH,
    "Play back a pad trace recorded with pad.record: every cellPadGetData answers with the "
    "recorded state of the latest record at or before the poll's (flip, poll), a neutral pad "
    "before the first record of a port and after the end of the trace, and the info calls report "
    "the recorded connection. The host pad and every injector are ignored. A malformed file, an "
    "unknown version or keys that go backwards end the run with kind pad-trace; a path that is "
    "not a readable file is a config error. A summary of how closely the guest followed the "
    "recording is printed at the end of the trace and at exit. Empty (the default) plays back "
    "nothing.")

/* ---- title -------------------------------------------------------------- */

PS3_CFG_STR(title, elf_sha256, "", 64, PS3_CFG_V_SHA256_OR_EMPTY,
    "Optional pin on the executable ppu_load_elf may load: its SHA-256 as 64 hex "
    "digits (either case). Checked in addition to the hash the lifter recorded "
    "in the lifted output, never instead of it. Empty means no pin.")

/* ---- host (the host process's scheduling; PS3RECOMP_HOST_*) ------------- */

PS3_CFG_BOOL(host, work_interval, 0,
    "Tell the host's performance controller about the one thread on the serial path from a pad poll to the "
    "present: the title's RSX walker joins an interval workgroup (ps3_host_work_interval_join, "
    "include/ps3emu/host_work_interval.h), is put in the Mach time-constraint band (period 16683 us, "
    "computation 4000 us, constraint 16000 us, preemptible) and wraps every FIFO pass in an interval whose "
    "deadline is host.work_interval_us after its start. On Apple Silicon in High Power mode this holds the "
    "thread's cluster at its top clock for the run, which shortens the pass and so the pad-to-present latency, "
    "at the price of CPU power (the cluster no longer idles down between passes). Low Power mode caps the "
    "clock and the option changes nothing there. macOS only, and links AudioToolbox: with the option on, a "
    "host that has no interval workgroup, or one that refuses the join, ends the run with kind config-invalid "
    "naming host.work_interval, because a run that asked for it must not silently run without it. Off (the "
    "default) calls no host framework and changes nothing. Changes how the host schedules the runtime, never "
    "what the guest sees. Read when the thread starts.")

PS3_CFG_U32(host, work_interval_us, 500, 50, 16000,
    "With host.work_interval: the deadline of each interval in microseconds, counted from its start. The "
    "controller sizes the clock to finish the declared work by it, so a shorter deadline asks for a higher "
    "clock. 500 us is what was measured; the range is one pass up to one frame (16.7 ms).")

/* ---- diag --------------------------------------------------------------- */

PS3_CFG_BOOL(diag, dump_config, 0,
    "Print the effective configuration (every key, its value and where the value "
    "came from) to stderr once it is loaded.")

/* ---- log ---------------------------------------------------------------- */

PS3_CFG_STR(log, file, "", 1023, PS3_CFG_V_NONE,
    "The run log file (docs/LOGGING.md). Empty (the default) writes none. Set, the runtime moves an "
    "existing file to <file>.prev (replacing an older .prev, so exactly one previous run survives) and "
    "creates a fresh one; every line the runtime prints through ps3_log goes into it as "
    "\"<seconds> <thread> <E|W|I|D> <line as on stderr>\", with what only a file can hold: collapsed "
    "repeats, what a per-site cap swallowed and the stop banner. stderr is unchanged. A path that "
    "cannot be rotated or created, or that names a directory, ends the run with kind host-log-file.")

PS3_CFG_STR(log, level, "info", 5, PS3_CFG_V_LOG_LEVEL,
    "The most verbose level that is printed, on stderr and in the file: \"error\", \"warn\", \"info\" "
    "(the default) or \"debug\". Call sites migrated from fprintf are info, so the default hides "
    "nothing that printed before.")

PS3_CFG_STR(log, mute, "", 255, PS3_CFG_V_LOG_TAGS,
    "Comma-separated tags (the text inside [..] at the start of a line, characters A-Za-z0-9_.-) "
    "whose lines are not printed on stderr. The file keeps them. Empty mutes nothing.")

PS3_CFG_STR(log, collapse, "file", 4, PS3_CFG_V_LOG_COLLAPSE,
    "Consecutive identical lines from one call site: \"file\" (the default) writes the first and then "
    "one \"[log] previous line repeated N times\" line to the file only, stderr prints every line; "
    "\"all\" collapses stderr the same way (stderr is then no longer byte-identical to the "
    "unmigrated output); \"off\" collapses nothing.")

PS3_CFG_U32(log, max_mb, 256, 1, 65535,
    "Size cap of the log file in MiB. At the cap the file gets one \"size cap reached\" line at exit "
    "and nothing else; stderr is unaffected. Protects device storage.")

/* ---- legacy environment variables --------------------------------------- */
/*
 * Existing diagnostic and host display knobs that read PS3RECOMP_* straight
 * from the environment and are not (yet) options. The environment loader treats
 * every other PS3RECOMP_* variable as a typo and stops, so each one that is
 * still read elsewhere has to be listed or running a title with it set would
 * stop. Moving one into the registry is how it leaves this list.
 */

/* runtime diagnostics, host display and backends (libs/) */
PS3_CFG_LEGACY_ENV("PS3RECOMP_ENG_BORDER")
PS3_CFG_LEGACY_ENV("PS3RECOMP_ENG_DEPTH_VIA_GUEST")
PS3_CFG_LEGACY_ENV("PS3RECOMP_ENG_POLY_OFFSET")
PS3_CFG_LEGACY_ENV("PS3RECOMP_ENG_RECT_CLEAR")
PS3_CFG_LEGACY_ENV("PS3RECOMP_ENG_TEXHASH_FULL")
PS3_CFG_LEGACY_ENV("PS3RECOMP_ENG_USER_CLIP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_FFMPEG")
PS3_CFG_LEGACY_ENV("PS3RECOMP_FFMPEG_AVCODEC")
PS3_CFG_LEGACY_ENV("PS3RECOMP_FFMPEG_AVUTIL")
PS3_CFG_LEGACY_ENV("PS3RECOMP_FULLSCREEN")
PS3_CFG_LEGACY_ENV("PS3RECOMP_HOST_SURFACES")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FIXED_FUNCTION")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FPS")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FRAME_DUMP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FRAME_DUMP_LIST")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_FRAME_DUMP_RANGE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_HEADLESS")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_MRT_MASK")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_SHADER_DUMP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_METAL_WINDOW")
PS3_CFG_LEGACY_ENV("PS3RECOMP_MSL_CACHE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_MSL_FAST")
PS3_CFG_LEGACY_ENV("PS3RECOMP_MSL_INVARIANT")
PS3_CFG_LEGACY_ENV("PS3RECOMP_RSX_ENGINE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_SPIRV_CACHE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DEVICE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DUMP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DUMP_EVERY")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DUMP_LIST")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_DUMP_RANGE")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_FULLSCREEN")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_GUEST_PROGRAMS")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_HOLD")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_MRT_MASK")
PS3_CFG_LEGACY_ENV("PS3RECOMP_VK_WINDOW")
PS3_CFG_LEGACY_ENV("PS3RECOMP_WINDOW_STATE")
/* tool-side (tools/): exported in the same shells that run a title */
PS3_CFG_LEGACY_ENV("PS3RECOMP_DIR")
PS3_CFG_LEGACY_ENV("PS3RECOMP_ARCHIVE_ROOT")
PS3_CFG_LEGACY_ENV("PS3RECOMP_PSN_ROOT")
PS3_CFG_LEGACY_ENV("PS3RECOMP_OUT")
PS3_CFG_LEGACY_ENV("PS3RECOMP_7ZIP")
PS3_CFG_LEGACY_ENV("PS3RECOMP_PS3SCE")
