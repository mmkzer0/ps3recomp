# Build directories
build/
build-*/
cmake-build-*/
out/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
!/cmake/*.cmake

# Compiled objects and libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exp
*.pdb

# Executables
*.exe
*.out
*.app

# Precompiled headers
*.gch
*.pch

# IDE / Editor files
.vs/
.vscode/
*.suo
*.user
*.sln
*.vcxproj*
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg
.venv/
venv/
env/

# Recompiled output (generated, not tracked)
recompiled/

# Game files (never commit these)
*.elf
*.ELF
*.self
*.SELF
*.bin
*.BIN
*.pkg
*.PKG
*.sfo
*.SFO
*.sprx
*.SPRX

# Decryption keys
*.keys
*.rap

# OS files
.DS_Store
Desktop.ini
Thumbs.db
ehthumbs.db

# Logs
*.log

# Harness batch-run outputs (per-title JSON, work dirs, REPORT.md)
_harness/
.pr_review/
_drill/

# Local Claude Code settings
.claude/

# macOS packaging output
*.dmg

# Gate builds: a port (or the toolkit) built against the toolkit under test,
# kept separate from the developer's own build/ so a gate run cannot be fooled
# by a stale binary. See tools/regress.py.
build-gate/

# Scratch space for generated test drivers and their output (test_ppu_lift.py,
# test_milestone.py).
scratch/

# Firmware and anything lifted from it stay local (docs/FIRMWARE_LLE.md)
fw_spu/
*.prx
*.PRX

# SPU differential test build products (runtime/spu/tests/build_diff_test.sh)
runtime/spu/tests/build_diff/

# hwprobe build outputs (tools/hwprobe/build.sh): SELFs and SHA256SUMS in out/, per-layer
# build trees, link maps (*.elf and *.self are already ignored above) and fetched results
tools/hwprobe/out/
tools/hwprobe/results/
tools/hwprobe/probes/*/layer*/build/
tools/hwprobe/probes/*/layer*/*.map
tools/hwprobe/probes/*/generated/
tools/hwprobe/probes/*/spu/*.map
tools/hwprobe/probes/*/layer*/*.elf
tools/hwprobe/probes/*/layer*/*.self
tools/hwprobe/probes/*/layer*/*.fake.self
!tools/hwprobe/probes/*/layer*/Makefile
!tools/hwprobe/probes/*/spu/Makefile
